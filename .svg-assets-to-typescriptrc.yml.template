inputs:
  - .
parser:
  cssVariableAttribute: affinity:id
  cssVariableRegex: (--[a-z0-9-_]+)\b
  svgoPlugins:
    - removeDoctype
    - removeXMLProcInst
    - removeComments
    - removeMetadata
    - name: removeEditorsNSData
      params:
        additionalNamespaces:
          - https://www.affinity.studio/
    - cleanupAttrs
    - mergeStyles
    - inlineStyles
    - minifyStyles
    - cleanupIds
    - removeUselessDefs
    - cleanupNumericValues
    - convertColors
    - removeUnknownsAndDefaults
    - removeNonInheritableGroupAttrs
    - removeUselessStrokeAndFill
    - removeViewBox
    - cleanupEnableBackground
    - removeHiddenElems
    - removeEmptyText
    - convertShapeToPath
    - convertEllipseToCircle
    - moveElemsAttrsToGroup
    - moveGroupAttrsToElems
    - collapseGroups
    - convertPathData
    - convertTransform
    - removeEmptyAttrs
    - removeEmptyContainers
    - mergePaths
    - removeUnusedNS
    - sortDefsChildren
    - removeTitle
    - removeDesc
  js2svg:
    pretty: false
writer:
  constPrefix: scaIcon
  assetInterfaceName: ScaIcon
